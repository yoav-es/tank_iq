// ui/tsconfig.json

{
  "compilerOptions": {
    /* Base Options */
    "target": "es2020", 
    "module": "esnext",
    
    /* CRITICAL: Includes types for Promise, async/await, and browser APIs (fetch) */
    "lib": ["es2020", "dom", "dom.iterable"], 
    
    /* ******** FIX IS HERE ********** */
    "moduleResolution": "bundler", 
    /* ******************************* */

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    
    /* Vue/Vite Specifics */
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    
    /* Path Aliases (if needed, but kept generic here) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules"]
}