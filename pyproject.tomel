# pyproject.toml
[build-system]
requires = ["setuptools>=61.0.0"]
build-backend = "setuptools.build_meta"

[project]
name = "tankiq"
version = "0.1.0"
description = "FastAPI backend for logging fuel entries"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    # Include all required libraries here
    "fastapi",
    "pydantic",
    "uvicorn",
    "faker",
    "pytest",
    "matplotlib"
]

[tool.setuptools.packages]
# This tells setuptools that the source code is in the 'app' directory
find = {where = ["."]}